<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane stylesheets="@style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.example.myapp.reportsController">

    <left>
        <VBox styleClass="sidebar">
            <Label styleClass="label" text="Teacher Panel" />
            <Button fx:id="dashboardBtn" text="Dashboard" onAction="#openDashboard" styleClass="button" />
            <Button fx:id="takeAttendanceBtn" text="Take Attendance" onAction="#openAttendance" styleClass="button" />
            <Button fx:id="reportsBtn" text="Reports" styleClass="button" />
            <Button fx:id="logoutBtn" text="Logout" onAction="#logout" styleClass="button" />
        </VBox>
    </left>

    <center>
        <VBox spacing="20">
            <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
            <Label text="Attendance Reports" styleClass="header-label"/>

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label text="Class:" styleClass="sub-header-label"/>
                <ComboBox fx:id="classFilter" prefWidth="150" styleClass="combo-box"/>
                <Label text="Date:" styleClass="sub-header-label"/>
                <DatePicker fx:id="dateFilter" styleClass="date-picker"/>
                <Button fx:id="filterBtn" text="Filter" onAction="#filterReports" styleClass="button, btn-primary"/>
            </HBox>

            <ScrollPane fitToWidth="true" prefHeight="400" style="-fx-background-color: transparent; -fx-background: transparent;">
                <content>
                    <VBox fx:id="reportCards" spacing="15" style="-fx-background-color: transparent;">
                        <VBox spacing="15">
                            <padding>
                                <Insets top="10" right="20" bottom="10" left="20"/>
                            </padding>
                        </VBox>
                    </VBox>
                </content>
            </ScrollPane>

        </VBox>
    </center>
</BorderPane>
