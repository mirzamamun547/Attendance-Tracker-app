<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>

<AnchorPane stylesheets="@style.css" prefHeight="400.0" prefWidth="600.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.myapp.login">

    <children>
        <VBox alignment="CENTER" spacing="20" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.topAnchor="0">

            <Label styleClass="header-label" text="Attendance Tracker" />

            <Label fx:id="userTypeLabel" text="Login to Continue" styleClass="sub-header-label" />

            <VBox fx:id="back1" spacing="15" styleClass="card" maxWidth="350">
                <TextField fx:id="emailField" promptText="Email" styleClass="text-field" />
                <PasswordField fx:id="passwordField" promptText="Password" styleClass="password-field" />
                
                <Button onAction="#handleLogin" styleClass="button, btn-primary" text="Login" maxWidth="Infinity" />
                <Button fx:id="back" onAction="#back" styleClass="button, btn-secondary" text="Back" maxWidth="Infinity" />
                
                <Hyperlink onAction="#goToSignup" text="Create an account" styleClass="hyperlink" />
            </VBox>
        </VBox>
    </children>
</AnchorPane>
