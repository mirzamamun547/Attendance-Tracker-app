<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane stylesheets="@style.css" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/25" fx:controller="com.example.myapp.attendanceController">

    <left>
        <VBox styleClass="sidebar">
            <Label styleClass="label" text="Teacher Panel" />

            <Button fx:id="dashboardBtn" text="Dashboard" onAction="#openDashboard" styleClass="button" />

            <Button fx:id="takeAttendanceBtn" text="Take Attendance" styleClass="button" />

            <Button fx:id="reportsBtn" text="Reports" onAction="#openReports" styleClass="button" />

            <Button fx:id="logoutBtn" text="Logout" onAction="#logout" styleClass="button" />
        </VBox>
    </left>

    <center>
        <VBox spacing="20">
            <padding>
                <Insets bottom="30" left="30" right="30" top="30" />
            </padding>

            <Label styleClass="header-label" text="Take Attendance" />

            <HBox spacing="15" alignment="CENTER_LEFT">
                <Label styleClass="sub-header-label" text="Class:" />
                <ComboBox fx:id="classBox" prefWidth="150" styleClass="combo-box" />

                <Label styleClass="sub-header-label" text="Date:" />
                <DatePicker fx:id="datePicker" styleClass="date-picker" />
            </HBox>

            <TableView fx:id="tableView" prefHeight="400" styleClass="table-view">
                <columns>
                    <TableColumn fx:id="rollCol" prefWidth="100" text="Roll No" />
                    <TableColumn fx:id="nameCol" prefWidth="250" text="Name" />
                    <TableColumn fx:id="presentCol" prefWidth="100" text="Present" />
                </columns>
            </TableView>

            <Button fx:id="saveBtn" styleClass="button, btn-primary" text="Save Attendance" />
        </VBox>
    </center>
</BorderPane>
