<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.chart.*?>

<BorderPane stylesheets="@style.css" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.example.myapp.DashboardController">
    <left>
        <VBox styleClass="sidebar">
            <Label styleClass="label" text="Teacher Panel" />
            <Button fx:id="dashboardBtn" text="Dashboard" styleClass="button" />
            <Button fx:id="takeAttendanceBtn" text="Take Attendance" onAction="#openAttendance" styleClass="button" />
            <Button fx:id="reportsBtn" text="Reports" onAction="#openReports" styleClass="button" />
            <Button fx:id="logoutBtn" text="Logout" onAction="#logout" styleClass="button" />
        </VBox>
    </left>

    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <!-- Tab 1: Daily Overview (Existing) -->
            <Tab text="Overview">
                <VBox spacing="20">
                    <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>
                    <Label styleClass="header-label" text="Daily Overview" />
                    <HBox spacing="15">
                        <Button fx:id="addStudentBtn" styleClass="button, btn-primary" text="Add Student" />
                        <Button fx:id="deleteStudentBtn" styleClass="button, btn-danger" text="Delete Student" />
                        <Button fx:id="addClassBtn" styleClass="button, btn-success" text="Add Class" onAction="#createClass"/>
                    </HBox>
                    <HBox spacing="15" alignment="CENTER_LEFT">
                        <Label text="Select Date:" styleClass="sub-header-label"/>
                        <DatePicker fx:id="datePicker" styleClass="date-picker"/>
                        <Button text="Load Attendance" onAction="#loadAttendanceByDate" styleClass="button, btn-secondary"/>
                    </HBox>
                    <TableView fx:id="studentTable" prefHeight="400" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="rollCol" prefWidth="100" text="Roll No" />
                            <TableColumn fx:id="nameCol" prefWidth="150" text="Name" />
                            <TableColumn fx:id="classCol" prefWidth="120" text="Class" />
                            <TableColumn fx:id="presentCol" prefWidth="80" text="Present" />
                        </columns>
                    </TableView>
                </VBox>
            </Tab>

            <!-- Tab 2: Leave Requests -->
            <Tab text="Leave Requests" onSelectionChanged="#loadLeaveRequests">
                <VBox spacing="20">
                    <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>
                    <Label styleClass="header-label" text="Pending Leave Requests" />
                    <TableView fx:id="leaveTable" prefHeight="300" styleClass="table-view">
                        <columns>
                            <TableColumn fx:id="leaveStudentCol" prefWidth="150" text="Student Name" />
                            <TableColumn fx:id="leaveClassCol" prefWidth="100" text="Class" />
                            <TableColumn fx:id="leaveDateCol" prefWidth="120" text="Date" />
                            <TableColumn fx:id="leaveReasonCol" prefWidth="250" text="Reason" />
                        </columns>
                    </TableView>
                    <HBox spacing="15">
                        <Button text="Approve Selected" onAction="#approveLeave" styleClass="button, btn-success"/>
                        <Button text="Deny Selected" onAction="#denyLeave" styleClass="button, btn-danger"/>
                        <Button text="Refresh" onAction="#loadLeaveRequests" styleClass="button, btn-secondary"/>
                    </HBox>
                </VBox>
            </Tab>

            <!-- Tab 3: Analytics -->
            <Tab text="Analytics" onSelectionChanged="#loadAnalytics">
                <VBox spacing="20">
                    <padding><Insets bottom="30" left="30" right="30" top="30" /></padding>
                    <Label styleClass="header-label" text="Class Attendance Trends" />
                    <LineChart fx:id="attendanceChart" prefHeight="250">
                        <xAxis><CategoryAxis label="Date"/></xAxis>
                        <yAxis><NumberAxis label="Attendance %" lowerBound="0" upperBound="100"/></yAxis>
                    </LineChart>
                    <Label styleClass="header-label" text="At-Risk Students (&lt; 75%)" />
                    <ListView fx:id="atRiskList" prefHeight="150" styleClass="table-view" />
                </VBox>
            </Tab>
        </TabPane>
    </center>
</BorderPane>
